{
  "name": "Telegram Bot Simple",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "telegram",
        "responseCode": 200,
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 200]
    },
    {
      "parameters": {
        "functionCode": "const body = $input.first().input;\nconst message = body?.message || body;\nreturn {\n  chat_id: message?.chat?.id,\n  message_id: message?.message_id,\n  user_name: message?.from?.first_name || 'User',\n  text: message?.text || '(無訊息)',\n  timestamp: message?.date\n};"
      },
      "id": "function",
      "name": "Process Message",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [300, 200]
    },
    {
      "parameters": {
        "authentication": "botToken",
        "botToken": "YOUR_TELEGRAM_TOKEN",
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "6119894493",
        "text": "感謝您的訊息！我已收到。"
      },
      "id": "telegram",
      "name": "Send Telegram Message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [500, 200]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Process Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Message": {
      "main": [
        [
          {
            "node": "Send Telegram Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
