# Get your Financial Datasets API key from https://financialdatasets.ai/
FINANCIAL_DATASETS_API_KEY=your-financial-datasets-api-key

# Get your Firecrawl API key from https://firecrawl.dev/
FIRECRAWL_API_KEY=your-firecrawl-api-key

# Get your Apify API token from https://apify.com/
APIFY_API_TOKEN=your-apify-api-token

# Transport mode: stdio (local) or sse (cloud deployment)
MCP_TRANSPORT=stdio
# Port for SSE mode (cloud platforms like Railway set this automatically)
PORT=8000
